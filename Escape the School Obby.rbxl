					<Item class="Script" referent="RBX61">
						<Properties>
							<bool name="Disabled">false</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">BowScript</string>
							<string name="Source">-- SonOfSevenless
print(&quot;Ice Shard Loaded&quot;)
local COOLDOWN = 1
r = game:service(&quot;RunService&quot;)
MAX_VELOCITY  = 200
MIN_VELOCITY  = 20
PULLBACK_TIME = 1
wait(1)
local Arrow = Instance.new(&quot;Part&quot;)
Arrow.Locked = true
Arrow.BackSurface = 0
Arrow.BottomSurface = 0
Arrow.FrontSurface = 0
Arrow.LeftSurface = 0
Arrow.RightSurface = 0
Arrow.TopSurface = 0
Arrow.formFactor = 2
Arrow.Size = Vector3.new(1,.4,4)
Arrow.BrickColor = BrickColor.new(11)
Arrow.Transparency = .2
script.Parent.ArrowScript:clone().Parent = Arrow
local force = Instance.new(&quot;BodyForce&quot;)
force.force = Vector3.new(0,313,0)
force.Parent = Arrow
function fire(mouse_pos, VELOCITY)
	sound = Instance.new(&quot;Sound&quot;)
	sound.SoundId = &quot;rbxasset://sounds\\Rubber band sling shot.wav&quot;
	sound.Parent = script.Parent
	sound.PlayOnRemove = true
	sound.Parent = nil
-- find player&apos;s head pos
	local head = game.Players.LocalPlayer.Character:findFirstChild(&quot;Head&quot;)
	if head == nil then return end
	local dir = mouse_pos - head.Position
	dir = computeDirection(dir)
	local launch = head.Position + 7 * dir
	local delta = mouse_pos - launch
	delta = delta / (delta.magnitude)
	local missile = Arrow:clone()
        
		
	missile.CFrame = CFrame.new(launch, launch + dir)
	--missile.Position = launch
	missile.Velocity = delta * VELOCITY
	missile.ArrowScript.Disabled = false
	local creator_tag = Instance.new(&quot;ObjectValue&quot;)
	creator_tag.Value = game.Players.LocalPlayer
	creator_tag.Name = &quot;creator&quot;
	creator_tag.Parent = missile
	
	missile.Parent = game.Workspace
end
function computeDirection(vec)
	local lenSquared = vec.magnitude * vec.magnitude
	local invSqrt = 1 / math.sqrt(lenSquared)
	return Vector3.new(vec.x * invSqrt, vec.y * invSqrt, vec.z * invSqrt)
end
enabled = true
function onButton1Down(mouse)
	if not enabled then
		return
	end
	local player = game.Players.LocalPlayer
	if player == nil then return end
	enabled = false
	mouse.Icon = &quot;rbxasset://textures\\GunWaitCursor.png&quot;
	-- find the best cf
	--local cf = mouse.Hit
	--local v = cf.lookVector
	local pos = mouse.Hit.p
	
	fire(pos, MAX_VELOCITY)
	
	wait(COOLDOWN)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	enabled = true
end
function onSelected(mouse)
	mouse.Icon = &quot;rbxasset://textures\\GunCursor.png&quot;
	mouse.Button1Down:connect(function() onButton1Down(mouse) end)
end
script.Parent.Selected:connect(onSelected)
