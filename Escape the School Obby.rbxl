					<Item class="Script" referent="RBX60">
						<Properties>
							<bool name="Disabled">true</bool>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">ArrowScript</string>
							<string name="Source">arrow = script.Parent
damage = 20
function stick(hit)
	-- joint myself to the thing i hit
	local weld = Instance.new(&quot;Weld&quot;)
	weld.Part0 = arrow
	weld.Part1 = hit
	local HitPos = arrow.Position + (arrow.CFrame.lookVector * 2.2)
	local CJ = CFrame.new(HitPos)
	local C0 = arrow.CFrame:inverse() *CJ
	local C1 = hit.CFrame:inverse() * CJ
	
	weld.C0 = C0
	weld.C1 = C1
	weld.Parent = arrow
end
function onTouched(hit)
	stick(hit)
	humanoid = hit.Parent:findFirstChild(&quot;Humanoid&quot;)
	if humanoid~=nil then
		tagHumanoid(humanoid)
		humanoid.Health = humanoid.Health - damage
		wait(2)
		untagHumanoid(humanoid)
	else
		connection:disconnect()
	end
end
function tagHumanoid(humanoid)
	-- todo: make tag expire
	local tag = arrow:findFirstChild(&quot;creator&quot;)
	if tag ~= nil then
		local new_tag = tag:clone()
		new_tag.Parent = humanoid
		
	end
end
function untagHumanoid(humanoid)
	if humanoid ~= nil then
		local tag = humanoid:findFirstChild(&quot;creator&quot;)
		if tag ~= nil then
			
			tag.Parent = nil
		end
	end
end
connection = arrow.Touched:connect(onTouched)
r = game:service(&quot;RunService&quot;)
t, s = r.Stepped:wait()
d = t + 20.0 - s
while t &lt; d do
	t = r.Stepped:wait()
end
arrow.Parent = nil
